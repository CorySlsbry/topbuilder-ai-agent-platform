# =============================================================================
# Top Builder AI — environment contract
# Copy to `.env` and fill in. NEVER commit `.env`.
# =============================================================================

# ---- Runtime ----
ENV=dev                       # dev | staging | prod  (dev enables /auth/dev-token)
LOG_LEVEL=INFO
API_PORT=8000

# ---- Database -------------------------------------------------------------
# RUNTIME connection: the app connects as a NON-superuser, NON-BYPASSRLS role
# so Row-Level Security is actually enforced. See docs/adr/0002.
DATABASE_URL=postgresql+asyncpg://app_user:app_pw@localhost:5432/fieldops

# ADMIN connection: used ONLY by the migration runner (creates roles, tables,
# RLS policies). Superuser. Never used to serve requests.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fieldops

# ---- Auth / JWT -----------------------------------------------------------
# HS256 shared secret for the dev token issuer. In prod, swap to your IdP's
# JWKS (Supabase / Auth0 / Entra) — see app/security.py.
JWT_SECRET=change-me-to-a-long-random-string-in-prod
JWT_ISSUER=fieldops-iq
JWT_AUDIENCE=fieldops-api
JWT_EXPIRY_MINUTES=60

# ---- Anthropic (the LLM reasoning layer) ----------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# The reasoning node EXPLAINS deterministic numbers; it never computes them.
WORKFORCE_REASONING_MODEL=claude-sonnet-4-6
# Set to 1 to skip live LLM calls and use the deterministic narrative fallback
# (lets the whole pipeline run + be tested with no API key).
DISABLE_LLM=0

# ---- ServiceTitan adapter -------------------------------------------------
# fixture | live   (slice ships with `fixture`; `live` needs the creds below)
SERVICETITAN_MODE=fixture
SERVICETITAN_CLIENT_ID=
SERVICETITAN_CLIENT_SECRET=
SERVICETITAN_APP_KEY=
SERVICETITAN_TENANT_ID=
SERVICETITAN_BASE_URL=https://api.servicetitan.io
SERVICETITAN_AUTH_URL=https://auth.servicetitan.io/connect/token

# ---- Google Workspace (Drive / Sheets) OAuth -----------------------------
# Per-customer Authorization-Code OAuth (mirrors Procore). The customer admin connects their Drive +
# Sheets so the Financial agent can read their AR-tracker sheet + budget-to-actual doc directly.
# Create an OAuth 2.0 Web client in Google Cloud Console; add the redirect URI below to its allowed
# redirect URIs. The long-lived refresh_token is encrypted in the credential vault (provider="google").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=          # e.g. https://api.example.com/v1/integrations/google/callback
# Space-delimited scopes (read-only Drive + Sheets to start, + userinfo.email to label the connection):
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/spreadsheets.readonly https://www.googleapis.com/auth/userinfo.email

# ---- QuickBooks Online (Intuit) OAuth ------------------------------------
# DIRECT Intuit OAuth 2.0 — NO Zapier / no iPaaS. The customer admin connects their QBO company in
# Intuit's consent screen; the callback receives code + state + realmId (the company id). We exchange
# the code server-side and encrypt {refresh_token, realm_id} in the credential vault (provider=
# "quickbooks"). Create an app at developer.intuit.com; add the redirect URI below to its allowed
# redirect URIs (must be HTTPS in prod). ACCOUNTING_MODE=quickbooks selects the live data path.
ACCOUNTING_MODE=fixture                 # fixture | quickbooks
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=                # e.g. https://api.example.com/v1/integrations/quickbooks/callback
QUICKBOOKS_SCOPES=com.intuit.quickbooks.accounting
QUICKBOOKS_ENVIRONMENT=sandbox          # sandbox | production (selects which API base to read from)
# Authorize + token hosts are the same for sandbox and production (Intuit routes by client id):
QUICKBOOKS_AUTHORIZE_URL=https://appcenter.intuit.com/connect/oauth2
QUICKBOOKS_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
# API base — production by default; for sandbox reads use https://sandbox-quickbooks.api.intuit.com
QUICKBOOKS_BASE_URL=https://quickbooks.api.intuit.com
# These are populated by the OAuth callback per-tenant (vault); set only for a single-tenant live run:
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_REALM_ID=

# ---- Auth ----------------------------------------------------------------
# dev = local HS256 issuer (/auth/dev-token). jwks = verify an external OIDC IdP.
AUTH_MODE=dev
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLE_CLAIM=role

# ---- Web hardening --------------------------------------------------------
ALLOWED_ORIGINS=*           # comma-separated origins in prod, e.g. https://app.example.com
TRUSTED_HOSTS=*             # comma-separated host allowlist in prod
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40
HSTS_ENABLED=0              # set 1 in prod (behind HTTPS)

# ---- Credential vault -----------------------------------------------------
# Fernet key (urlsafe-base64, 32 bytes) used to envelope-encrypt stored ServiceTitan/QBO tokens.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ---- Embeddings / RAG -----------------------------------------------------
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

# ---- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
